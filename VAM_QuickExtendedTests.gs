function logx(id,r){if(typeof vamQuickLogResult_==='function')return vamQuickLogResult_(id,r);Logger.log('[VAM_QUICK] '+JSON.stringify({event:'FEATURE_RESULT',details:{featureId:id,assetRowsChanged:0}}));return r;}
function ctx(){return vamReadAssetRows_();}var C={get f(){return VAM_GOV_CONFIG.fields;}};
function has(c,f){return vamHasHeader_(c.headerMap,f);}function miss(f,c){return{fieldName:f,headerPresent:false,rowCount:c?c.records.length:0,message:'Configured field was not found on the Visual Asset Metadata sheet.',assetRowsChanged:0};}
function prev(r,f,why){return{rowNumber:r.rowNumber,assetId:vamClean_(r.values[C.f.assetId]),assetName:vamClean_(r.values[C.f.assetName]),fieldName:f,value:vamClean_(r.values[f]),reason:why,assetRowsChanged:0};}
function dist(f){var c=ctx();if(!has(c,f))return miss(f,c);var g={};c.records.forEach(function(r){var v=vamClean_(r.values[f])||'(blank)',k=vamCompare_(v);g[k]=g[k]||{value:v,count:0,sampleRows:[]};g[k].count++;if(g[k].sampleRows.length<10)g[k].sampleRows.push(r.rowNumber);});return Object.keys(g).map(function(k){return{fieldName:f,value:g[k].value,count:g[k].count,sampleRows:g[k].sampleRows.join(', ')};}).sort(function(a,b){return b.count-a.count;});}
function blank(f){var c=ctx();if(!has(c,f))return miss(f,c);return c.records.filter(function(r){return!vamClean_(r.values[f]);}).slice(0,100).map(function(r){return prev(r,f,'Blank');});}
function dupes(f){var c=ctx();if(!has(c,f))return miss(f,c);var g={};c.records.forEach(function(r){var v=vamClean_(r.values[f]);if(!v)return;var k=vamCompare_(v);g[k]=g[k]||{value:v,rows:[]};g[k].rows.push(r.rowNumber);});return Object.keys(g).map(function(k){return g[k];}).filter(function(x){return x.rows.length>1;}).sort(function(a,b){return b.rows.length-a.rows.length;}).slice(0,50).map(function(x){return{fieldName:f,value:x.value,count:x.rows.length,rows:x.rows.join(', ')};});}
function len(f,min,max){var c=ctx();if(!has(c,f))return miss(f,c);return c.records.filter(function(r){var n=vamClean_(r.values[f]).length;return n>0&&(n<min||n>max);}).slice(0,100).map(function(r){var p=prev(r,f,'Length outlier');p.length=vamClean_(r.values[f]).length;p.expectedLength=min+'-'+max;return p;});}
function short(f,min){var c=ctx();if(!has(c,f))return miss(f,c);return c.records.filter(function(r){var n=vamClean_(r.values[f]).length;return n>0&&n<min;}).slice(0,100).map(function(r){var p=prev(r,f,'Too short');p.length=vamClean_(r.values[f]).length;p.minimumLength=min;return p;});}
function unsafe(f){var c=ctx();if(!has(c,f))return miss(f,c);return c.records.filter(function(r){return/[^\w\s.\-()/?&:=#%]/.test(vamClean_(r.values[f]));}).slice(0,100).map(function(r){return prev(r,f,'Unsafe character review');});}
function idFormat(){var c=ctx(),f=C.f.assetId;if(!has(c,f))return miss(f,c);return c.records.filter(function(r){var id=vamClean_(r.values[f]);return id&&!/^[A-Z0-9]+(?:-[A-Z0-9]+)*-\d{3,}$/.test(id);}).slice(0,100).map(function(r){return prev(r,f,'Format review');});}
function idPrefixes(){var c=ctx(),f=C.f.assetId;if(!has(c,f))return miss(f,c);var g={};c.records.forEach(function(r){var id=vamClean_(r.values[f]),v=id?id.replace(/-?\d+$/,'')||'(no prefix)':'(blank)',k=vamCompare_(v);g[k]=g[k]||{prefix:v,count:0,sampleRows:[]};g[k].count++;if(g[k].sampleRows.length<10)g[k].sampleRows.push(r.rowNumber);});return Object.keys(g).map(function(k){return{prefix:g[k].prefix,count:g[k].count,sampleRows:g[k].sampleRows.join(', ')};}).sort(function(a,b){return b.count-a.count;});}
function idGaps(){var c=ctx(),f=C.f.assetId;if(!has(c,f))return miss(f,c);var g={};c.records.forEach(function(r){var m=vamClean_(r.values[f]).match(/^(.*?)-(\d+)$/);if(!m)return;g[m[1]]=g[m[1]]||[];g[m[1]].push(Number(m[2]));});return Object.keys(g).map(function(p){var a=g[p].sort(function(x,y){return x-y;}),gaps=[];for(var i=1;i<a.length;i++)if(a[i]-a[i-1]>1)gaps.push((a[i-1]+1)+'-'+(a[i]-1));return{prefix:p,count:a.length,min:a[0],max:a[a.length-1],gaps:gaps.slice(0,25).join(', ')};}).filter(function(x){return x.gaps;});}
function driveRows(mode){var c=ctx(),f=C.f.driveLink;if(!has(c,f))return miss(f,c);return c.records.filter(function(r){var v=vamClean_(r.values[f]);if(!v)return false;var ok=!!vamExtractDriveFileId_(v);return mode==='parseable'?ok:!ok;}).slice(0,100).map(function(r){return prev(r,f,mode==='parseable'?'Parseable link':'Unparseable link');});}
function idMismatch(){var c=ctx(),lf=C.f.driveLink,idf=C.f.driveFileId;if(!has(c,lf)||!has(c,idf))return miss(lf+' / '+idf,c);return c.records.filter(function(r){var p=vamExtractDriveFileId_(r.values[lf]),id=vamClean_(r.values[idf]);return p&&id&&p!==id;}).slice(0,100).map(function(r){var p=prev(r,idf,'Drive File ID mismatch');p.parsedId=vamExtractDriveFileId_(r.values[lf]);p.currentId=vamClean_(r.values[idf]);return p;});}
function folderMismatch(){var c=ctx(),a='Folder',b='Folder ID';if(!has(c,a)||!has(c,b))return miss(a+' / '+b,c);return c.records.filter(function(r){return!!vamClean_(r.values[a])!==!!vamClean_(r.values[b]);}).slice(0,100).map(function(r){return prev(r,a,'Folder or Folder ID missing counterpart');});}
function extDist(f){var c=ctx();if(!has(c,f))return miss(f,c);var g={};c.records.forEach(function(r){var m=vamClean_(r.values[f]).match(/\.([A-Za-z0-9]{1,10})$/),e=m?m[1].toLowerCase():'(missing extension)';g[e]=g[e]||{extension:e,count:0,sampleRows:[]};g[e].count++;if(g[e].sampleRows.length<10)g[e].sampleRows.push(r.rowNumber);});return Object.keys(g).map(function(k){return{fieldName:f,extension:g[k].extension,count:g[k].count,sampleRows:g[k].sampleRows.join(', ')};}).sort(function(a,b){return b.count-a.count;});}
function missingExt(f){var c=ctx();if(!has(c,f))return miss(f,c);return c.records.filter(function(r){var v=vamClean_(r.values[f]);return v&&!/\.[A-Za-z0-9]{1,10}$/.test(v);}).slice(0,100).map(function(r){return prev(r,f,'Missing extension');});}
function canonMatch(){var c=ctx(),o=C.f.originalFilename,cn=C.f.canonicalFilename;if(!has(c,o)||!has(c,cn))return miss(o+' / '+cn,c);return c.records.filter(function(r){var a=vamClean_(r.values[o]),b=vamClean_(r.values[cn]);return a&&b&&b===vamSuggestCanonicalFilename_(a);}).slice(0,100).map(function(r){return prev(r,cn,'Canonical matches suggestion');});}
function toDate(v){if(Object.prototype.toString.call(v)==='[object Date]'&&!isNaN(v.getTime()))return v;var t=vamClean_(v);if(!t)return null;var d=new Date(t);return isNaN(d.getTime())?null:d;}
function badDate(f){var c=ctx();if(!has(c,f))return miss(f,c);return c.records.filter(function(r){return vamClean_(r.values[f])&&!toDate(r.values[f]);}).slice(0,100).map(function(r){return prev(r,f,'Invalid date');});}
function futureDate(f){var c=ctx(),now=new Date();if(!has(c,f))return miss(f,c);return c.records.filter(function(r){var d=toDate(r.values[f]);return d&&d.getTime()>now.getTime();}).slice(0,100).map(function(r){return prev(r,f,'Future date');});}
function staleDate(f,days){var c=ctx(),cut=new Date().getTime()-days*86400000;if(!has(c,f))return miss(f,c);return c.records.filter(function(r){var d=toDate(r.values[f]);return d&&d.getTime()<cut;}).slice(0,100).map(function(r){var p=prev(r,f,'Stale date');p.maxAgeDays=days;return p;});}
function links(f){var c=ctx();if(!has(c,f))return miss(f,c);return c.records.filter(function(r){var v=vamClean_(r.values[f]);return/^https?:\/\//i.test(v)||!!vamExtractDriveFileId_(v);}).slice(0,100).map(function(r){return prev(r,f,'Parseable link');});}
function ready(step){var rep=buildVisualAssetValidationReport(),c=ctx(),bad={},f=C.f.nextWorkflowStep;rep.issues.forEach(function(i){if(i.rowNumber)bad[i.rowNumber]=true;});return c.records.filter(function(r){return!bad[r.rowNumber]&&(!step||vamCompare_(vamClean_(r.values[f]))===vamCompare_(step));}).slice(0,100).map(function(r){return prev(r,f,'Ready for '+step);});}
function top(n){return buildVisualAssetValidationReport().topFixes.slice(0,n);}
